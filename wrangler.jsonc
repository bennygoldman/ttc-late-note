{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttc-late-note",
  "compatibility_date": "2026-11-01",
  "main": "./workers/app.ts",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ttc-late-note",
      // Replace with the real id from `wrangler d1 create ttc-late-note` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": {
    "crons": [
      "*/5 * * * *", // every 5 minutes: record TTC live service alerts
      "17 * * * *"   // hourly: import new rows from the Toronto Open Data delay logs
    ]
  }
}
