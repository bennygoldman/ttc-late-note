{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttc-late-note",
  "compatibility_date": "2026-11-01",
  "main": "./workers/app.ts",
  "observability": { "enabled": true },

  // The site's address. www redirects to it (see workers/app.ts).
  // The main workers.dev address is off; preview addresses (from
  // `npx wrangler preview` on a branch) stay on for testing changes.
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "latenote.to", "custom_domain": true },
    { "pattern": "www.latenote.to", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ttc-late-note",
      "database_id": "6f8017f9-6d94-4be2-8bd7-fbe6342cc68f",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": {
    "crons": [
      "*/5 * * * *", // every 5 minutes: record TTC live service alerts
      "17 * * * *"   // hourly: import new rows from the Toronto Open Data delay logs
    ]
  }
}
