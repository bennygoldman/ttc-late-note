{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttc-late-note",
  "compatibility_date": "2026-11-01",
  "main": "./workers/app.ts",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ttc-late-note",
      "database_id": "6f8017f9-6d94-4be2-8bd7-fbe6342cc68f",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": {
    "crons": [
      "*/5 * * * *", // every 5 minutes: record TTC live service alerts
      "17 * * * *"   // hourly: import new rows from the Toronto Open Data delay logs
    ]
  }
}
